{
  "name": "zayden",
  "private": true,
  "version": "0.0.0",
  "description": "ZAYDEN — governed multi-provider AI runtime integration program",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "intake:validate": "node scripts/validate-source-intake.mjs",
    "intake:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/migrate-sources-to-research.ps1",
    "test": "npm run test:unit && npm run test:contracts && npm run test:integration",
    "test:unit": "node --test tests/unit/intake-registry.test.mjs",
    "test:contracts": "tsx --test tests/contracts/chat-contract.test.ts tests/contracts/provider-contract.test.ts tests/contracts/error-contract.test.ts tests/contracts/runtime-inspection.test.ts",
    "test:integration": "tsx --test tests/integration/provider-gateway.test.ts tests/integration/provider-bridge.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "gate:intake": "npm run intake:validate && npm test",
    "gate:phase2": "npm run typecheck && npm run test:contracts",
    "gate:phase4": "npm run typecheck && npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
