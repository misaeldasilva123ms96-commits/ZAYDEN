{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zayden.local/schemas/observability/event/v0.1.0",
  "title": "ZAYDEN observability event (v0.1.0 stub)",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "timestamp_ms", "event_type", "runtime_mode", "provider_actual"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1.0" },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "event_type": { "type": "string", "minLength": 1 },
    "runtime_mode": { "type": "string", "enum": ["local", "cloud", "hybrid"] },
    "provider_actual": {
      "type": "object",
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["openai_compatible", "gemini", "ollama", "local_gguf", "unknown"]
        },
        "name": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "fallback_reason": {
      "type": "object",
      "required": ["did_fallback"],
      "properties": {
        "did_fallback": { "type": "boolean" },
        "code": { "type": ["string", "null"] },
        "detail": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "latency_ms": { "type": ["integer", "null"], "minimum": 0 },
    "tool_trace": { "type": ["object", "null"], "additionalProperties": true }
  }
}
