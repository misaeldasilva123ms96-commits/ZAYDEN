{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "runtime/contracts/**/*.ts",
    "runtime/core/**/*.ts",
    "runtime/providers/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/contracts/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/resilience/**/*.ts",
    "tests/harness/**/*.ts"
  ]
}
